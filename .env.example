# Copy this file to .env and fill in values.

# RAG_MODE selects how answers are produced:
#   mock  -> no AWS at all (guaranteed working demo)
#   local -> Bedrock embeddings + in-code retrieval + Bedrock generation
#   kb    -> REAL AWS: Amazon Bedrock Knowledge Base (needs KB_ID)
RAG_MODE=mock

# AWS region where Bedrock model access is enabled
AWS_REGION=us-east-1

# Bedrock model IDs (must be enabled in the Bedrock console)
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Required only when RAG_MODE=kb. Copy from the Bedrock Knowledge Base console.
KB_ID=

# Optional Bedrock Guardrail (leave blank to disable)
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# AWS credentials come from `aws configure` / env / IAM role.
# NEVER paste AWS keys into code.
